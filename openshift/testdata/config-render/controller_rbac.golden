# This project was developed with assistance from AI tools.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: chartassignment-controller
  namespace: your-project-namespace
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: chartassignment-controller
  namespace: your-project-namespace
rules:
- apiGroups:
  - apps.cloudrobotics.com
  resources:
  - chartassignments
  verbs:
  - get
  - list
  - watch
  - update
  - patch
- apiGroups:
  - apps.cloudrobotics.com
  resources:
  - chartassignments/status
  verbs:
  - get
  - update
  - patch
- apiGroups:
  - apps.cloudrobotics.com
  resources:
  - chartassignments/finalizers
  verbs:
  - update
  - patch
- apiGroups:
  - apps.cloudrobotics.com
  resources:
  - resourcesets
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
  - deletecollection
- apiGroups:
  - apps.cloudrobotics.com
  resources:
  - resourcesets/finalizers
  verbs:
  - update
  - patch
- apiGroups:
  - events.k8s.io
  - ''
  resources:
  - events
  verbs:
  - create
  - patch
  - update
- apiGroups:
  - ''
  resources:
  - configmaps
  - services
  - serviceaccounts
  - persistentvolumeclaims
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
- apiGroups:
  - ''
  resources:
  - pods
  verbs:
  - get
  - list
  - watch
- apiGroups:
  - apps
  resources:
  - deployments
  - statefulsets
  - daemonsets
  - replicasets
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
- apiGroups:
  - batch
  resources:
  - jobs
  - cronjobs
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
- apiGroups:
  - rbac.authorization.k8s.io
  resources:
  - roles
  - rolebindings
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
- apiGroups:
  - networking.k8s.io
  resources:
  - networkpolicies
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
- apiGroups:
  - networking.istio.io
  resources:
  - virtualservices
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
- apiGroups:
  - monitoring.coreos.com
  resources:
  - servicemonitors
  - podmonitors
  verbs:
  - get
  - list
  - watch
  - create
  - update
  - patch
  - delete
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: chartassignment-controller
  namespace: your-project-namespace
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: chartassignment-controller
subjects:
- kind: ServiceAccount
  name: chartassignment-controller
  namespace: your-project-namespace
