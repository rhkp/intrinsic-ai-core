# This project was developed with assistance from AI tools.
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    intrinsic.ai/controller-config-checksum: 321b14caa9e00b952b401b57322f26165bb98dbe8d5dbcd01ad046cfb3c05669
  name: chartassignment-controller
  namespace: your-project-namespace
spec:
  strategy:
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 1
    type: RollingUpdate
  template:
    metadata:
      annotations:
        intrinsic.ai/controller-config-checksum: 321b14caa9e00b952b401b57322f26165bb98dbe8d5dbcd01ad046cfb3c05669
    spec:
      containers:
      - args:
        - --watch-namespace=your-project-namespace
        - --cloud-cluster=true
        - --webhook-enabled=false
        - --healthz-port=8080
        - --target-config=/etc/intrinsic/controller-config/target-config.json
        - --image-lock=/etc/intrinsic/controller-config/image-lock.json
        name: controller
        volumeMounts:
        - mountPath: /etc/intrinsic/controller-config
          name: intrinsic-controller-config
          readOnly: true
      volumes:
      - configMap:
          name: intrinsic-target-config
        name: intrinsic-controller-config
