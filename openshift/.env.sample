# Generic target settings. Replace these values locally; never commit the real values.
OPENSHIFT_CONTEXT=replace-with-your-context-name
OPENSHIFT_NAMESPACE=your-project-namespace
OPENSHIFT_API_SERVER_URL=https://api.example.invalid:6443
OPENSHIFT_GPU_TAINT_KEY=your-gpu-taint-key
QUAY_REGISTRY_ORG=your-registry-org
OPENSHIFT_STORAGE_CLASS=your-block-storage-class
PVC_SIZE=your-approved-pvc-size

# Local-only smoke input for openshift/deployment/apply-runtime-secret.sh.
# Copy to .env, replace with a throwaway value, and never commit .env.
INTRINSIC_RUNTIME_SMOKE_SECRET=replace-with-a-local-smoke-value

# Required by the namespace-scoped ChartAssignment adapter for gRPC routing.
# The dedicated gateway is internal-only in the target project. Not secrets.
INTRINSIC_INGRESS_ADDRESS=intrinsic-grpc-gateway.your-project-namespace.svc.cluster.local:80
INTRINSIC_INGRESS_GATEWAY=your-project-namespace/intrinsic-grpc-internal
