# Local-only smoke input for openshift/deployment/apply-runtime-secret.sh.
# Copy to .env, replace with a throwaway value, and never commit .env.
INTRINSIC_RUNTIME_SMOKE_SECRET=replace-with-a-local-smoke-value

# Required by the namespace-scoped ChartAssignment adapter for gRPC routing.
# The dedicated gateway is internal-only in the target project. Not secrets.
INTRINSIC_INGRESS_ADDRESS=intrinsic-grpc-gateway.arhkp-intrinsic.svc.cluster.local:80
INTRINSIC_INGRESS_GATEWAY=arhkp-intrinsic/intrinsic-grpc-internal
