      org.opencontainers.image.version="20260922.0" \
      org.opencontainers.image.source="https://github.com/intrinsic-ai/intrinsic-omts" \
      org.opencontainers.image.revision="8253cdfdd173da9d5b7c9bb7b8cee817f66902ae"

ENV HOME=/tmp \
    TMPDIR=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/intrinsic

COPY --chmod=0444 omts_app.zip /opt/intrinsic/omts_app.zip
