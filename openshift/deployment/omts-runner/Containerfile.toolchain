FROM registry.access.redhat.com/ubi10/ubi-minimal@sha256:ab0348d8ef0435d8c069792602b7943a97affab6ef5789d8bd9cc492f7756782 AS builder

USER 0
RUN microdnf install -y \
      binutils \
      ca-certificates \
      diffutils \
      findutils \
      gcc \
      gcc-c++ \
      git \
      git-lfs \
      gzip \
      make \
      patch \
      python3 \
      python3-pip \
      tar \
      unzip \
      xz \
      zstd \
    && microdnf clean all \
    && git lfs install --system

RUN set -eux; \
    curl --fail --location --silent --show-error \
      --output /tmp/bazelisk-amd64.deb \
      https://github.com/bazelbuild/bazelisk/releases/download/v1.29.0/bazelisk-amd64.deb; \
    echo '186d78a20e1a64f59ba08987791a989892d142c9d3a9f9cc0c5c35e201f53924  /tmp/bazelisk-amd64.deb' | sha256sum --check -; \
    data_member="$(ar t /tmp/bazelisk-amd64.deb | awk '/^data[.]tar([.]|$)/ { print; exit }')"; \
    case "${data_member}" in \
      data.tar) ar p /tmp/bazelisk-amd64.deb "${data_member}" | tar -xf - -C /tmp ;; \
      data.tar.xz) ar p /tmp/bazelisk-amd64.deb "${data_member}" | tar -xJf - -C /tmp ;; \
      data.tar.zst) ar p /tmp/bazelisk-amd64.deb "${data_member}" | tar --zstd -xf - -C /tmp ;; \
      data.tar.gz) ar p /tmp/bazelisk-amd64.deb "${data_member}" | tar -xzf - -C /tmp ;; \
      *) echo "unsupported Bazelisk Debian archive member: ${data_member}" >&2; exit 1 ;; \
    esac; \
    install -m 0755 /tmp/usr/bin/bazelisk /usr/local/bin/bazel; \
    rm -rf /tmp/bazelisk-amd64.deb /tmp/usr

COPY openshift/deployment/omts-runner/ /opt/intrinsic/repo/openshift/deployment/omts-runner/
COPY openshift/deployment/intrinsic-omts/configs/lab_bb_01/app_config.yaml /opt/intrinsic/repo/openshift/deployment/intrinsic-omts/configs/lab_bb_01/app_config.yaml
COPY patches/omts-anonymous-releases.patch /opt/intrinsic/repo/patches/omts-anonymous-releases.patch
COPY patches/omts-openshift-core-registry-keychain.patch /opt/intrinsic/repo/patches/omts-openshift-core-registry-keychain.patch
COPY patches/omts-openshift-demo-configs.patch /opt/intrinsic/repo/patches/omts-openshift-demo-configs.patch
COPY patches/omts-openshift-module-registry-keychain.patch /opt/intrinsic/repo/patches/omts-openshift-module-registry-keychain.patch
COPY patches/omts-openshift-sim-config-safety.patch /opt/intrinsic/repo/patches/omts-openshift-sim-config-safety.patch
COPY patches/omts-tinygltf-bcr-override.patch /opt/intrinsic/repo/patches/omts-tinygltf-bcr-override.patch
COPY patches/intrinsic-core-triton-digest-pin.patch /opt/intrinsic/repo/patches/intrinsic-core-triton-digest-pin.patch

ENV HOME=/opt/intrinsic/home \
    TMPDIR=/opt/intrinsic/tmp \
    BAZELISK_HOME=/opt/intrinsic/home/.cache/bazelisk \
    INTRINSIC_OMTS_SRC=/opt/intrinsic/home/intrinsic-omts \
    USER=omts-builder \
    LOGNAME=omts-builder \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN mkdir -p /opt/intrinsic/home /opt/intrinsic/tmp \
    && chown -R 1001:0 /opt/intrinsic \
    && chmod -R g+rwX /opt/intrinsic

USER 1001:0
WORKDIR /opt/intrinsic/repo/openshift/deployment/omts-runner
RUN ./build-solution-cli.sh && ./build-runner-artifacts.sh

FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:d1bad2a2790eac1651e57e78159a81b72ddfa7b836936b26cf51e09744bf1c2d AS runner

LABEL org.opencontainers.image.title="Intrinsic OMTS OpenShift demo runner" \
      org.opencontainers.image.version="20260922.0" \
      org.opencontainers.image.source="https://github.com/intrinsic-ai/intrinsic-omts" \
      org.opencontainers.image.revision="8253cdfdd173da9d5b7c9bb7b8cee817f66902ae"

ENV HOME=/opt/intrinsic/home \
    TMPDIR=/opt/intrinsic/tmp \
    BAZELISK_HOME=/opt/intrinsic/home/.cache/bazelisk \
    INTRINSIC_OMTS_SRC=/opt/intrinsic/home/intrinsic-omts \
    USER=omts-builder \
    LOGNAME=omts-builder \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 0
RUN microdnf install -y \
      ca-certificates \
      git \
      git-lfs \
      java-17-openjdk-headless \
      python3.11 \
    && microdnf clean all \
    && git lfs install --system \
    && ln -s /usr/bin/python3.11 /usr/local/bin/python3

COPY --from=builder --chown=1001:0 /opt/intrinsic /opt/intrinsic
COPY --from=builder /usr/local/bin/bazel /usr/local/bin/bazel
COPY --from=builder --chown=1001:0 --chmod=0444 /opt/intrinsic/home/intrinsic-omts/bazel-bin/src/omts_app.zip /opt/intrinsic/omts_app.zip
COPY --from=builder --chown=1001:0 --chmod=0444 /opt/intrinsic/home/intrinsic-omts/bazel-bin/tools/pose_estimation/register_using_train_service.zip /opt/intrinsic/register_using_train_service.zip
COPY --from=builder --chmod=0444 /opt/intrinsic/repo/openshift/deployment/intrinsic-omts/configs/lab_bb_01/app_config.yaml /etc/intrinsic/lab_bb_01/app_config.yaml
COPY --from=builder --chmod=0444 /opt/intrinsic/home/intrinsic-omts/LICENSE /licenses/LICENSE.omts
COPY --from=builder --chmod=0444 /opt/intrinsic/home/intrinsic-omts/TRADEMARK.md /licenses/TRADEMARK.omts.md
COPY --from=builder --chmod=0555 /opt/intrinsic/repo/openshift/deployment/omts-runner/omts-runner /usr/local/bin/omts-runner

USER 1001:0
WORKDIR /opt/intrinsic/repo/openshift/deployment/omts-runner

RUN /usr/local/bin/omts-runner app-help >/dev/null \
    && /usr/local/bin/omts-runner register-help >/dev/null

# The deployed tool pod runs the solution from this baked Bazel cache. Fail the
# image build if this final UBI 9 stage would need to recompile with its older
# system runtime.
RUN cd "${INTRINSIC_OMTS_SRC}" \
    && if ! bazel --batch build \
      --config=lab_bb_01 \
      //:omts_solution >/tmp/omts-solution-smoke.log 2>&1; then \
      tail -n 100 /tmp/omts-solution-smoke.log; \
      exit 1; \
    fi

ENTRYPOINT ["/usr/local/bin/omts-runner"]
CMD ["serve"]
