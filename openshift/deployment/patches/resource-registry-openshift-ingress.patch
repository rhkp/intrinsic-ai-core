-const (
-	ingressAddress = `istio-ingressgateway.app-ingress.svc.cluster.local:80`
-)
+const ingressAddressEnv = "INTRINSIC_INGRESS_ADDRESS"
+
+// configuredIngressAddress returns the validated, in-cluster OpenShift gateway
+// address used by ResourceHandles. Requiring explicit configuration prevents
+// the upstream K3s ingress from being published to service clients.
+func configuredIngressAddress() (string, error) {
+	address := strings.TrimSpace(os.Getenv(ingressAddressEnv))
+	if address == "" {
+		return "", fmt.Errorf("%s must name the in-cluster Service Mesh ingress Service", ingressAddressEnv)
+	}
+	host, portText, err := net.SplitHostPort(address)
+	labels := strings.Split(host, ".")
+	if err != nil || net.ParseIP(host) != nil || len(labels) != 5 ||
+		labels[0] == "" || labels[1] == "" || labels[2] != "svc" || labels[3] != "cluster" || labels[4] != "local" {
+		return "", fmt.Errorf("%s must be service.namespace.svc.cluster.local:80", ingressAddressEnv)
+	}
+	if labels[0] == "istio-ingressgateway" && labels[1] == "app-ingress" {
+		return "", fmt.Errorf("%s must not reference the shared ingress Service", ingressAddressEnv)
+	}
+	port, err := strconv.Atoi(portText)
+	if err != nil || port != 80 {
+		return "", fmt.Errorf("%s must use internal Service port 80", ingressAddressEnv)
+	}
+	return address, nil
+}
 
