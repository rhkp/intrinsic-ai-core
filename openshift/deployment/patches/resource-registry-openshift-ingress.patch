--- /dev/null
+++ b/intrinsic/resources/service/resourcereader_test.go
@@ -0,0 +1,36 @@
+package resourcereader
+
+import "testing"
+
+func TestConfiguredIngressAddress(t *testing.T) {
+	tests := []struct {
+		name    string
+		address string
+		wantErr bool
+	}{
+		{name: "project service", address: "intrinsic-grpc-gateway.pilot.svc.cluster.local:80"},
+		{name: "missing", address: "", wantErr: true},
+		{name: "shared ingress", address: "istio-ingressgateway.app-ingress.svc.cluster.local:80", wantErr: true},
+		{name: "external hostname", address: "gateway.example.invalid:80", wantErr: true},
+		{name: "IP address", address: "192.0.2.10:80", wantErr: true},
+		{name: "wrong port", address: "gateway.pilot.svc.cluster.local:8080", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(ingressAddressEnv, tt.address)
+			got, err := configuredIngressAddress()
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("configuredIngressAddress() = %q, want error", got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("configuredIngressAddress() error = %v", err)
+			}
+			if got != tt.address {
+				t.Fatalf("configuredIngressAddress() = %q, want %q", got, tt.address)
+			}
+		})
+	}
+}
