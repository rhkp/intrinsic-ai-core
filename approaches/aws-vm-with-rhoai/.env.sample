# This project was developed with assistance from AI tools.
# Working hybrid profile only. Copy to .env; keep real values out of Git.
# Consumed explicitly with --env-file; never automatically sourced by another topology.
# Paths are relative to this file, or absolute. Store no tokens/private-key contents here.
HYBRID_CONFIG_VERSION=1
HYBRID_OPENSHIFT_CONTEXT=your-openshift-context
HYBRID_RHOAI_NAMESPACE=your-project
HYBRID_RHOAI_ROUTE=hybrid-triton-grpc
# gRPC target uses hostname:443, with no https:// prefix or REST path.
HYBRID_RHOAI_ENDPOINT=hybrid-grpc.your-apps-domain.example:443
HYBRID_RHOAI_CA_FILE=../../.local/your-hybrid-experiment/ca.crt
HYBRID_RHOAI_CLIENT_ACCOUNT=your-model-client-sa
HYBRID_RHOAI_SEGMENTATION_MODEL=ai.intrinsic.ioc_pose_estimation.segmentor.rfdetr
HYBRID_RHOAI_POSE_MODEL=ai.intrinsic.ioc_pose_estimation.pose_estimator.foundationpose
HYBRID_VM_SSH_HOST=ubuntu@your-aws-vm
HYBRID_VM_SSH_KEY=~/.ssh/your-vm-key.pem
