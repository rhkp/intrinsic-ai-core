# Configuration contract for the future AWS VM -> RHOAI inference client.
# Copy to .env for local, non-secret settings; .env files are gitignored.
# Current preflight/bootstrap scripts and smoke manifest do not load this file.

# Set only after the route and network path have been approved and verified.
RHOAI_INFERENCE_URL=https://replace-me.example.invalid/v2/models/demo-model
RHOAI_GRPC_INFERENCE_URL=https://replace-me.example.invalid
RHOAI_MODEL_NAME=demo-model

# Recommended initial pilot: dedicated service-account bearer token,
# configured with RHOAI token authentication for the model endpoint.
RHOAI_AUTH_MODE=service-account-bearer
RHOAI_BEARER_TOKEN_FILE=/secure/path/to/short-lived-token

# Use the approved CA bundle and keep TLS verification enabled.
RHOAI_CA_BUNDLE_FILE=/secure/path/to/approved-ca-bundle.pem

# Alternative only if an approved gateway/identity provider supports OAuth2
# client credentials. Do not place the client secret itself in this file.
# RHOAI_AUTH_MODE=oauth2-client-credentials
# RHOAI_OAUTH_TOKEN_URL=https://replace-me.example.invalid/oauth/token
# RHOAI_OAUTH_CLIENT_ID=replace-me
# RHOAI_OAUTH_CLIENT_SECRET_FILE=/secure/path/to/oauth-client-secret
