# Default-deny JSON. Live cluster observations, inventories, snapshots, and
# other environment-specific data must stay ignored. JSON samples use the exact
# `*.sample.json` suffix and must contain placeholders only. Add any other
# negation only for a reviewed, sanitized fixture and document why it belongs in
# Git.
*.json
*.json.bak
*.json.local
*.json.live
*.json.new
*.json.orig
*.json.prod
*.json.private
*.json.rej
*.json.snapshot
*.json.tmp
*.jsonl
*.ndjson
!*.sample.json
!openshift/config.schema.json
!openshift/config.example.json
# Hybrid schema and sanitized example only; config.local.json stays ignored.
!approaches/aws-vm-with-rhoai/config.schema.json
!approaches/aws-vm-with-rhoai/config.example.json
!openshift/deployment/ADAPTATIONS.json
!openshift/deployment/SOURCE_MANIFEST.json
!openshift/image-lock.json

# Generated canonical configuration artifacts. Keep live values out of Git.
/openshift/.generated/
/openshift/target-config.json
/openshift/deployment/chartassignment-controller/deploy/target-config.configmap.yaml
/openshift/deployment/chartassignment-controller/deploy/controller-deployment-patch.yaml

# Codex runtime logs, local caches, and credential keys
.codex/cache/
.codex/history/
.codex/credentials/
.codex/*.local.toml
