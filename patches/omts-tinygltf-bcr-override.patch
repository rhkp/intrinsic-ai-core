+# Keep the registry's module metadata and overlay patches by using its corrected version.
+single_version_override(
+    module_name = "tinygltf",
+    version = "2.9.6.bcr.1",
+    patch_strip = 1,
+    patches = ["//bazel/patches:openshift_tinygltf_bazel_headers.patch"],
+)
+
+single_version_override(
+    module_name = "glib",
+    version = "2.82.2.bcr.9",
+    patch_strip = 1,
+    patches = ["//bazel/patches:openshift_glib_gmodule_header.patch"],
+)
+
+# Put source proto roots before generated copies during gRPC code generation.
+single_version_override(
+    module_name = "grpc",
+    version = "1.74.1",
+    patch_strip = 1,
+    patches = ["//bazel/patches:openshift_grpc_proto_path_order.patch"],
+)
+
+single_version_override(
+    module_name = "dumb-init",
