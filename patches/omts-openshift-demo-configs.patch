+            "common/*.yaml",
+            "your-workcell/*.pbtxt",
+            "your-workcell/*.textproto",
+            "your-workcell/*.yaml",
+        ],
+        exclude = ["your-workcell/ur_module_config.textproto"],
+    ),
+)
+
